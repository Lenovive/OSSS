# Normalize line endings: store LF in the repo and check out LF, regardless of
# core.autocrlf. Sources are already LF; this stops the CRLF conversion warnings
# and keeps diffs free of line-ending churn.
* text=auto eol=lf

# Windows-specific files that tooling expects with CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.exe binary
*.dll binary
*.pdb binary
